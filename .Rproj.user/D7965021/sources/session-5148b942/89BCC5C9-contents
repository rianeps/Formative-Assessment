# --- Clean BMI data ---
bmi <- bmi %>%
  rename(
    Country = `Country/Region/World`,
    BMI_Obesity = `Prevalence of BMI>=30 kg/m² (obesity)`,
    BMI_Obesity_Lower = `Prevalence of BMI>=30 kg/m² (obesity) lower 95% uncertainty interval`,
    BMI_Obesity_Upper = `Prevalence of BMI>=30 kg/m² (obesity) upper 95% uncertainty interval`
  ) %>%
  select(Year, Sex, Country, ISO, BMI_Obesity, BMI_Obesity_Lower, BMI_Obesity_Upper) %>%
  filter(Year >= 1980 & Year <= 2020)

# --- Clean Diabetes data ---
diabetes <- diabetes %>%
  rename(
    Country = `Country/Region/World`,
    Diabetes_Prev = `Prevalence of diabetes (18+ years)`,
    Diabetes_Lower = `Prevalence of diabetes (18+ years) lower 95% uncertainty interval`,
    Diabetes_Upper = `Prevalence of diabetes (18+ years) upper 95% uncertainty interval`
  ) %>%
  select(Year, Sex, Country, ISO, Diabetes_Prev, Diabetes_Lower, Diabetes_Upper) %>%
  filter(Year >= 1980 & Year <= 2020)

# Drop missing values
bmi <- bmi %>% drop_na(BMI_Obesity)
diabetes <- diabetes %>% drop_na(Diabetes_Prev)

